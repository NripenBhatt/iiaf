      "Quality gate": "No invented proceedings; language matches request"
    },
    {
      "Output_ID": "O08",
      "Output type": "Decision register",
      "Required deliverable": "XLSX/CSV or DOCX table",
      "Format requirements": "ID, agenda item, wording, status, authority if stated, owner/date if supplied",
      "Quality gate": "Decision states remain distinct"
    },
    {
      "Output_ID": "O09",
      "Output type": "Action tracker",
      "Required deliverable": "XLSX/CSV and readable table",
      "Format requirements": "Action, meeting/decision, owner, due date, status, completion proof",
      "Quality gate": "Overdue only when dates are reliable"
    },
    {
      "Output_ID": "O10",
      "Output type": "Table extraction",
      "Required deliverable": "XLSX/CSV plus source locators",
      "Format requirements": "Headers, row/column structure, units, totals, footnotes, page/sheet/cell references",
      "Quality gate": "Source sample cross-check passes; discrepancies flagged"
    },
    {
      "Output_ID": "O11",
      "Output type": "Accreditation evidence matrix",
      "Required deliverable": "XLSX/CSV plus in-app table",
      "Format requirements": "One row per source unit × agency × exact versioned requirement; rationale, locator, status",
      "Quality gate": "Exact requirement ID, source locator and status required"
    },
    {
      "Output_ID": "O12",
      "Output type": "Metric report",
      "Required deliverable": "XLSX/CSV; charts where suitable",
