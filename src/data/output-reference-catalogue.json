      "Quality gate": "Actual image file exists and opens; text-only response fails"
    },
    {
      "Output_ID": "O04",
      "Output type": "Social carousel",
      "Required deliverable": "PNG/JPG slides plus caption",
      "Format requirements": "Consistent dimensions, sequence, hook, readable text",
      "Quality gate": "Every slide exported; source trace retained"
    },
    {
      "Output_ID": "O05",
      "Output type": "Reel/video package",
      "Required deliverable": "Timed script, storyboard, on-screen text, cover image, caption",
      "Format requirements": "Scene timing, voice-over, visual direction, CTA; rendered video only if actually produced",
      "Quality gate": "UI never labels a script as a finished video"
    },
    {
      "Output_ID": "O06",
      "Output type": "Meeting agenda",
      "Required deliverable": "DOCX/PDF plus structured agenda table",
